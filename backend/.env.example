# =========================================================================
# ZEYLORAA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# Duplicate this file as .env and replace the values with your actual configuration.
# NEVER commit your real .env file or real production passwords to git/GitHub.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/jewellery_store?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# Google OAuth2 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Atelier Founder Contact
FOUNDER_EMAIL=concierge@zeyloraa.com

# =========================================================================
# INITIAL ONE-TIME SUPER ADMIN PROVISIONING
# Used by: npm run seed:admin
# =========================================================================
SUPER_ADMIN_NAME="Zeyloraa Master Admin"
SUPER_ADMIN_EMAIL="admin@zeyloraa.com"
SUPER_ADMIN_PASSWORD="ReplaceWithAStrongTemporaryPassword123!"

