# =========================================================================
# ZEYLORAA FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================================
# Duplicate this file as .env.local and replace with your actual values.
# In Render / Railway, set these variables in the Service Environment settings.

# Backend REST API Base URL (must end with /api)
# Local: http://localhost:5000/api
# Render: https://<your-backend-service-name>.onrender.com/api
# Railway: https://<your-backend-railway-url>/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google OAuth2 Client ID for Customer Social Sign-In
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

